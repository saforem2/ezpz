#!/bin/bash -l
#PBS -N fsdptp-bisect
#PBS -l select=2
#PBS -l walltime=00:50:00
#PBS -q workq
#PBS -A datascience
#PBS -l filesystems=home:tegu
#PBS -o /home/foremans/fsdptp-bisect.log
#PBS -j oe
#
# Why does fsdp_tp hang under `ezpz benchmark` when the TP validation
# passed 3/3 at this exact geometry (dp_shard=12, tp=2, ws=24)?
#
# Two variables differ between the passing run and the hanging one:
#   passing:  --model agpt-2b --dataset random    (job 12473890, 86s)
#   hanging:  --model large   --dataset stanfordnlp/imdb
#
# fsdp_tp.py:3336 branches on the dataset: `random` uses the built-in
# loader with broadcast_within_tp=True; anything else uses
# _build_hf_dataloader + TPBroadcastDataLoader. The TP validation only
# ever exercised the `random` branch, so HF+tp>1 is untested at
# multi-rank. Isolate which of the two variables matters.
#
# No `set -u`; module-load output kept (both cost a round earlier).
module load frameworks
echo "module load rc=$?  CONDA_PREFIX=${CONDA_PREFIX:-<unset>}"
export LD_LIBRARY_PATH="${CONDA_PREFIX:-}/lib:${LD_LIBRARY_PATH:-}"
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export WANDB_MODE=disabled PYTHONUNBUFFERED=1
# A hang should abort in 4 min, not eat the whole allocation.
export TORCH_DDP_TIMEOUT=240

SRC="${HOME}/ezpz-src"
export PYTHONPATH="${SRC}/src:${PYTHONPATH:-}"
echo "host=$(hostname)  ezpz=$(cd "$SRC" && git rev-parse --short HEAD)"

source "${SRC}/src/ezpz/bin/utils.sh" >/dev/null 2>&1
ezpz_setup_job >/dev/null 2>&1
echo "setup_job rc=$? NHOSTS=${NHOSTS:-?} NGPUS=${NGPUS:-?}"

W="${HOME}/fsdptp-bisect-${PBS_JOBID%%.*}"
mkdir -p "$W"
cd "$W" || exit 1

arm() {
    local label="$1"; shift
    echo "===== BEGIN ${label} ====="
    timeout 600 mpiexec -n 24 -ppn 12 python3 -m ezpz.examples.fsdp_tp \
        --train-iters 5 --batch-size 1 "$@" >"${W}/${label}.log" 2>&1
    rc=$?
    # Classify on EVIDENCE in the log, not the exit code: srun/mpiexec
    # tear-down makes a 10s crash and a 10min deadlock look identical.
    S=$(sed 's/\x1b\[[0-9;]*m//g' "${W}/${label}.log")
    iters=$(printf '%s' "$S" | grep -coE 'iter=[0-9]+')
    if printf '%s' "$S" | grep -qE 'iter=4|iter=5'; then
        echo "RESULT ${label} = TRAINS (${iters} iters, rc=${rc})"
    elif [ "$rc" -eq 124 ]; then
        echo "RESULT ${label} = HANG-WALLCLOCK (reached ${iters} iters)"
    elif printf '%s' "$S" | grep -qiE 'Watchdog|PROGRESS TIMEOUT|Abort'; then
        echo "RESULT ${label} = HANG-COLLECTIVE (reached ${iters} iters)"
    else
        echo "RESULT ${label} = OTHER rc=${rc} :: $(printf '%s' "$S" | grep -viE '^\[|CCL_WARN' | tail -2 | tr '\n' ' ' | cut -c1-160)"
    fi
    echo "===== END ${label} ====="
}

# A: the known-good control, at the benchmark's model. Exonerates or
#    implicates `--model large` independently of the dataset.
arm A-large-random-tp2   --model large   --dataset random --tp 2
# B: the benchmark's dataset, but TP off. Exonerates or implicates the
#    HF dataloader path independently of TP.
arm B-large-imdb-tp1     --model large   --dataset stanfordnlp/imdb --tp 1
# C: the failing combination, reproduced in this harness.
arm C-large-imdb-tp2     --model large   --dataset stanfordnlp/imdb --tp 2
# D: the originally-passing config, to prove the harness itself is sound.
arm D-agpt2b-random-tp2  --model agpt-2b --dataset random --tp 2

echo "PBS_DONE"
