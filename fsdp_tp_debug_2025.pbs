#!/bin/bash -l
#PBS -N fsdptp-dbg2025
#PBS -l select=2
#PBS -l walltime=00:45:00
#PBS -q debug
#PBS -A datascience
#PBS -l filesystems=home:flare
#PBS -o /home/foremans/fsdptp-dbg2025.log
#PBS -j oe
#
# THE bisect that matters: old oneAPI stack vs new, holding torch fixed.
#
# The passing baseline (Sunspot job 12473890, 3/3 at tp=1/2/4, 86 s for
# tp=2) ran **torch 2.13** -- the same version that stalls today. So the
# regression is NOT a torch version change. Every stalling run has used
# frameworks-2026.1.0 (/opt/aurora/26.181.0/...). The untested variable
# is the oneAPI/frameworks stack itself.
#
# This job runs frameworks/2025.3.1 on the `debug` queue. If tp=2 trains
# here, the fault is bisected to the 2026.1.0 stack -- a far more
# actionable report than "somewhere below PyTorch".
#
# Note 2025.3.1 ships torch 2.10, so a pass here is confounded with the
# torch version UNLESS read against the existing evidence: torch 2.13 and
# 2.15 both stall ON 2026.1.0, so a 2.10 pass on 2025.3.1 points at the
# stack, not at torch. Stated plainly so the limit is visible.
#
# CCL_KVS_MODE is deliberately NOT set: ALCF guidance says it is a
# next-eval requirement and this is the debug queue.
module load frameworks/2025.3.1
echo "module load rc=$?"
echo "CONDA_PREFIX=${CONDA_PREFIX:-<unset>}"
export LD_LIBRARY_PATH="${CONDA_PREFIX:-}/lib:${LD_LIBRARY_PATH:-}"

# What ezpz_setup_xpu exports; omitting FLAT cost a whole job earlier.
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export CCL_PROCESS_LAUNCHER=pmix
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export TORCH_CPP_LOG_LEVEL=ERROR
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export WANDB_MODE=disabled PYTHONUNBUFFERED=1

SRC="${HOME}/ezpz-src"
export PYTHONPATH="${SRC}/src:${PYTHONPATH:-}"
echo "host=$(hostname)  ezpz=$(cd "$SRC" && git rev-parse --short HEAD)"
echo "torch=$(python3 -c 'import torch;print(torch.__version__)' 2>&1 | tail -1)"

NDEV=$(python3 -c 'import torch;print(torch.xpu.device_count())' 2>&1 | tail -1)
echo "xpu device_count=${NDEV}"
[ "${NDEV}" = "12" ] || { echo "FATAL: expected 12 tiles, got '${NDEV}'"; exit 1; }

W="${HOME}/fsdptp-dbg2025-${PBS_JOBID%%.*}"
mkdir -p "$W"
cd "$W" || exit 1

BUDGET=300
arm() {
    local label="$1"; shift
    echo "===== BEGIN ${label} ====="
    local t1
    timeout "${BUDGET}" mpiexec -n 24 -ppn 12 python3 -m ezpz.examples.fsdp_tp \
        "$@" >"${W}/${label}.log" 2>&1
    t1=$(date +%s)
    # Last TIMESTAMPED line vs kill time. Exit code, iteration count and
    # file mtime have each given a wrong verdict in this investigation.
    local S last_ts last_epoch quiet iters n
    S=$(sed 's/\x1b\[[0-9;]*m//g' "${W}/${label}.log")
    iters=$(printf '%s' "$S" | grep -coE 'iter=[0-9]+')
    n=$(printf '%s' "$S" | grep -oE 'iter=[0-9]+' | tail -1)
    last_ts=$(printf '%s' "$S" | grep -oE '^\[20[0-9]{2}-[0-9]{2}-[0-9]{2} [0-9:]{8}\]' | tail -1 | tr -d '[]')
    if [ -z "$last_ts" ]; then
        echo "RESULT ${label} = NO-OUTPUT :: $(printf '%s' "$S" | grep -iE 'Error|Traceback' | head -1 | cut -c1-120)"
    else
        last_epoch=$(date -d "$last_ts" +%s 2>/dev/null || echo "$t1")
        quiet=$(( t1 - last_epoch ))
        if [ "$iters" -eq 0 ]; then
            echo "RESULT ${label} = NO-PROGRESS (0 iters, quiet ${quiet}s) :: $(printf '%s' "$S" | grep -iE 'Error' | head -1 | cut -c1-110)"
        elif [ "$quiet" -gt 60 ]; then
            echo "RESULT ${label} = STALLED (quiet ${quiet}s, reached ${n})"
        else
            echo "RESULT ${label} = HEALTHY (active to kill, reached ${n})"
        fi
    fi
    echo "===== END ${label} ====="
}

# D1 is decisive: the config that stalls on every 2026.1.0 stack tested.
arm D1-random-tp2 --model large --dataset random --tp 2
arm D2-imdb-tp2   --model large --dataset stanfordnlp/imdb --tp 2
# Control: tp=1 is healthy on 2026.1.0, so it must be healthy here too.
arm D3-imdb-tp1   --model large --dataset stanfordnlp/imdb --tp 1
# Matches the passing baseline's tp=4 cell.
arm D4-random-tp4 --model large --dataset random --tp 4

echo "PBS_DONE"
