#!/bin/bash -l
#PBS -N ezpz-v3
#PBS -l select=2
#PBS -l walltime=00:25:00
#PBS -q QUEUE_PLACEHOLDER
#PBS -A datascience
#PBS -l filesystems=FS_PLACEHOLDER
#PBS -o /home/foremans/ezpz-v3.log
#PBS -j oe
#
# Round 3. Two earlier rounds died on MY harness, not on ezpz:
#   r1: curl'd utils.sh inside the job -- compute nodes have no network,
#       so the file was empty and every function was undefined (rc=127).
#   r2: died at exit 1 with NO message, because the failing calls had
#       `>/dev/null 2>&1` on them. I threw away the diagnostic.
#
# So: no `set -u` (the script must survive to report), nothing silenced,
# `set -x` around the risky region, and every step prints its own rc.
# Everything below runs ON THE COMPUTE NODE -- login-node results do not
# predict this (SKILL.md), which is exactly how r2 misled me.

STAGE=/home/foremans/ezpzmain
U="$STAGE/utils.sh"
echo "=== context ==="
echo "host=$(hostname)"
echo "shell=${BASH_VERSION}  opts=$-"
if [[ -s "$U" ]]; then
    echo "utils sha=$(md5sum "$U" | cut -c1-12)  lines=$(wc -l <"$U")"
else
    echo "FATAL: $U missing/empty -- stage from a login node"
    exit 1
fi

echo "=== step 1: module load frameworks (output kept) ==="
module load frameworks
echo "  rc=$?"
echo "  CONDA_PREFIX=${CONDA_PREFIX:-<unset>}"

echo "=== step 2: torch import ==="
export LD_LIBRARY_PATH="${CONDA_PREFIX:-}/lib:${LD_LIBRARY_PATH:-}"
python3 -c 'import torch; print("  torch", torch.__version__)' 2>&1 | tail -3

echo "=== step 3: source utils.sh (output KEPT this time) ==="
# shellcheck disable=SC1090
source "$U"
echo "  source rc=$?"

echo "=== step 4: are the functions defined? ==="
for f in ezpz_setup_xpu ezpz_load_modules_sunspot ezpz_setup_job; do
    printf "  %-28s %s\n" "$f" "$(type -t "$f" 2>/dev/null || echo NOT-DEFINED)"
done

echo "=== step 5: #247 CCL_OP_SYNC round trip ON COMPUTE ==="
fails=0
for fn in ezpz_load_modules_sunspot ezpz_setup_xpu; do
    unset CCL_OP_SYNC
    "$fn" >/dev/null 2>&1
    v="${CCL_OP_SYNC-<unset>}"
    printf "  %-26s unset -> %s\n" "$fn" "$v"
    [[ "$v" == "<unset>" ]] || fails=1
    export CCL_OP_SYNC=0
    "$fn" >/dev/null 2>&1
    printf "  %-26s 0     -> %s\n" "$fn" "${CCL_OP_SYNC-<unset>}"
    [[ "${CCL_OP_SYNC-}" == "0" ]] || fails=1
    export CCL_OP_SYNC=1
    "$fn" >/dev/null 2>&1
    printf "  %-26s 1     -> %s\n" "$fn" "${CCL_OP_SYNC-<unset>}"
    [[ "${CCL_OP_SYNC-}" == "1" ]] || fails=1
    unset CCL_OP_SYNC
done
echo "  ccl_op_sync_247: $([[ $fails -eq 0 ]] && echo OK || echo FAIL)"

echo "=== step 6: ezpz_setup_job (output KEPT) ==="
ezpz_setup_job
echo "  rc=$?"
echo "  NHOSTS=${NHOSTS:-<unset>} NGPUS=${NGPUS:-<unset>} NGPU_PER_HOST=${NGPU_PER_HOST:-<unset>}"

echo "=== step 7: #243 crash-pattern parity ==="
echo "  failover.sh  std::bad_alloc: $(grep -c 'std::bad_alloc' "$STAGE/failover.sh")"
echo "  autoretry.py bad_alloc     : $(grep -c 'bad_alloc' "$STAGE/launch_autoretry.py")"

echo "=== step 8: real 2-node XCCL collective, CCL_OP_SYNC unset ==="
NP=$(($(wc -l <"${PBS_NODEFILE}") * 12))
export MASTER_ADDR=$(head -1 "${PBS_NODEFILE}")
export MASTER_PORT=29822
unset CCL_OP_SYNC
timeout 500 mpiexec -n "${NP}" -ppn 12 python3 "$STAGE/collective_min.py" xccl 2>&1 | tail -10

echo "=== step 9: same, explicit CCL_OP_SYNC=1 ==="
export CCL_OP_SYNC=1
export MASTER_PORT=29823
timeout 500 mpiexec -n "${NP}" -ppn 12 python3 "$STAGE/collective_min.py" xccl 2>&1 | tail -8

echo "PBS_DONE"
