#!/bin/bash -l
#PBS -N fsdptp-t215
#PBS -l select=2
#PBS -l walltime=00:40:00
#PBS -q next-eval
#PBS -A datascience
#PBS -l filesystems=home:flare
#PBS -o /home/foremans/fsdptp-t215.log
#PBS -j oe
#
# Is the tp>1 stall a PyTorch problem?
#
# Everything so far ran the frameworks/2026.1.0 stack, torch 2.13.0a0 --
# which the torchtitan notes describe as a "known-broken pytorch==2.13
# stack". This runs the SAME ezpz code against the custom torch 2.15 venv
# that torchtitan uses on next-eval.
#
# Per the torchtitan runtime contract: on next-eval, oneAPI 2026.1.0 is
# supplied by the QUEUE. Do NOT `module load frameworks` -- that pulls in
# the 2.13 conda stack this test is trying to avoid. Activate the
# isolated venv on top of the queue-provided runtime instead.
#
# Also sets CCL_KVS_MODE=pmi, which ALCF guidance says next-eval requires
# for oneCCL KVS init and which NONE of my earlier Aurora runs set.
V=/lus/flare/projects/AuroraGPT/foremans/venvs/xpu-torch215
PY="$V/bin/python"
[[ -x "$PY" ]] || { echo "FATAL: no interpreter at $PY"; exit 1; }

unset CCL_KVS_MODE
export CCL_KVS_MODE=pmi
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export WANDB_MODE=disabled PYTHONUNBUFFERED=1

SRC="${HOME}/ezpz-src"
export PYTHONPATH="${SRC}/src:${PYTHONPATH:-}"
echo "host=$(hostname)  ezpz=$(cd "$SRC" && git rev-parse --short HEAD)"
echo "torch=$("$PY" -c 'import torch;print(torch.__version__)' 2>&1 | tail -1)"
echo "CCL_KVS_MODE=${CCL_KVS_MODE}"

W="${HOME}/fsdptp-t215-${PBS_JOBID%%.*}"
mkdir -p "$W"
cd "$W" || exit 1

BUDGET=300
arm() {
    local label="$1"; shift
    echo "===== BEGIN ${label} ====="
    local t0 t1
    t0=$(date +%s)
    timeout "${BUDGET}" mpiexec -n 24 -ppn 12 "$PY" -m ezpz.examples.fsdp_tp \
        "$@" >"${W}/${label}.log" 2>&1
    t1=$(date +%s)
    # Classify on the LAST TIMESTAMPED LINE inside the log vs the kill
    # time. Exit code, iteration count, and file mtime have each produced
    # a wrong verdict in this investigation: mtime keeps advancing from
    # untimestamped CCL warnings long after real progress stops.
    local S last_ts last_epoch quiet iters n
    S=$(sed 's/\x1b\[[0-9;]*m//g' "${W}/${label}.log")
    iters=$(printf '%s' "$S" | grep -coE 'iter=[0-9]+')
    n=$(printf '%s' "$S" | grep -oE 'iter=[0-9]+' | tail -1)
    last_ts=$(printf '%s' "$S" | grep -oE '^\[20[0-9]{2}-[0-9]{2}-[0-9]{2} [0-9:]{8}\]' | tail -1 | tr -d '[]')
    if [ -z "$last_ts" ]; then
        echo "RESULT ${label} = NO-OUTPUT"
    else
        last_epoch=$(date -d "$last_ts" +%s 2>/dev/null || echo "$t1")
        quiet=$(( t1 - last_epoch ))
        if [ "$iters" -eq 0 ]; then
            echo "RESULT ${label} = NO-PROGRESS (0 iters, quiet ${quiet}s)"
        elif [ "$quiet" -gt 60 ]; then
            echo "RESULT ${label} = STALLED (quiet ${quiet}s, reached ${n})"
        else
            echo "RESULT ${label} = HEALTHY (active to kill, reached ${n})"
        fi
    fi
    echo "===== END ${label} ====="
}

# T1 is the decisive one: the config that stalls under torch 2.13.
arm T1-random-tp2 --model large --dataset random --tp 2
arm T2-imdb-tp2   --model large --dataset stanfordnlp/imdb --tp 2
# Control: tp=1 works under 2.13, so it must still work here.
arm T3-imdb-tp1   --model large --dataset stanfordnlp/imdb --tp 1
# Higher TP, to see whether any tp>1 survives.
arm T4-random-tp4 --model large --dataset random --tp 4

echo "PBS_DONE"
