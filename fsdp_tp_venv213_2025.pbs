#!/bin/bash -l
#PBS -N fsdptp-v213-2025
#PBS -l select=2
#PBS -l walltime=00:50:00
#PBS -q debug
#PBS -A datascience
#PBS -l filesystems=home:flare
#PBS -o /home/foremans/fsdptp-v213-2025.log
#PBS -j oe
#
# The clean bisect: torch 2.13 on the OLD oneAPI stack.
#
# Grid so far -- every cell on frameworks-2026.1.0 stalls at tp>1:
#
#   torch 2.13.0a0   (2026.1.0 conda)  STALL
#   torch 2.15.0.dev (custom venv)     STALL
#   ...with and without CCL_OP_SYNC=0 + CCL_ATL_SYNC_COLL=0
#
# The passing baseline (Sunspot job 12473890, 3/3, tp=2 in 86 s) also ran
# torch 2.13, so torch is not the changed variable -- the frameworks /
# oneAPI stack is. Job 8870519 tests frameworks/2025.3.1 but that ships
# torch 2.10, confounding stack with version.
#
# This removes the confound: torch 2.13.0.dev20260520+xpu from
#   /flare/AuroraGPT/foremans/projects/saforem2/torchtitan-ezpz/.venv.tar.gz
# on top of oneapi/2025.3.1. Same torch major as the passing baseline,
# old stack. If tp=2 trains here, the stack is indicted outright.
#
# Staged to node-local /tmp: the venv is 2.8 GB and 24 ranks reading it
# over the shared filesystem would measure the filesystem, not the bug.
module load frameworks/2025.3.1
echo "module load rc=$?  CONDA_PREFIX=${CONDA_PREFIX:-<unset>}"

T=/flare/AuroraGPT/foremans/projects/saforem2/torchtitan-ezpz/.venv.tar.gz
[[ -f "$T" ]] || { echo "FATAL: tarball missing at $T"; exit 1; }
D=/tmp/v213
mkdir -p "$D"
echo "unpacking $(du -h "$T" | cut -f1) to ${D} on every node..."
# Unpack on ALL nodes, not just the head -- ranks on node 1 need it too.
mpiexec -n 2 -ppn 1 bash -c "mkdir -p ${D} && tar xzf ${T} -C ${D}" || {
    echo "FATAL: unpack failed"; exit 1; }

PY="${D}/.venv/bin/python"
[[ -x "$PY" ]] || { echo "FATAL: no interpreter at $PY"; exit 1; }

# Keep the oneapi 2025.3.1 runtime, but let the venv own Python.
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export CCL_PROCESS_LAUNCHER=pmix
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export TORCH_CPP_LOG_LEVEL=ERROR
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export WANDB_MODE=disabled PYTHONUNBUFFERED=1

SRC="${HOME}/ezpz-src"
export PYTHONPATH="${SRC}/src:${PYTHONPATH:-}"
echo "host=$(hostname)  ezpz=$(cd "$SRC" && git rev-parse --short HEAD)"
echo "torch=$("$PY" -c 'import torch;print(torch.__version__)' 2>&1 | tail -1)"

NDEV=$("$PY" -c 'import torch;print(torch.xpu.device_count())' 2>&1 | tail -1)
echo "xpu device_count=${NDEV}"
[ "${NDEV}" = "12" ] || { echo "FATAL: expected 12 tiles, got '${NDEV}'"; exit 1; }

W="${HOME}/fsdptp-v213-2025-${PBS_JOBID%%.*}"
mkdir -p "$W"
cd "$W" || exit 1

BUDGET=300
arm() {
    local label="$1"; shift
    echo "===== BEGIN ${label} ====="
    local t1
    timeout "${BUDGET}" mpiexec -n 24 -ppn 12 "$PY" -m ezpz.examples.fsdp_tp \
        "$@" >"${W}/${label}.log" 2>&1
    t1=$(date +%s)
    # Last TIMESTAMPED line vs kill time -- exit code, iteration count and
    # file mtime have each produced a wrong verdict in this investigation.
    local S last_ts last_epoch quiet iters n
    S=$(sed 's/\x1b\[[0-9;]*m//g' "${W}/${label}.log")
    iters=$(printf '%s' "$S" | grep -coE 'iter=[0-9]+')
    n=$(printf '%s' "$S" | grep -oE 'iter=[0-9]+' | tail -1)
    last_ts=$(printf '%s' "$S" | grep -oE '^\[20[0-9]{2}-[0-9]{2}-[0-9]{2} [0-9:]{8}\]' | tail -1 | tr -d '[]')
    if [ -z "$last_ts" ]; then
        echo "RESULT ${label} = NO-OUTPUT :: $(printf '%s' "$S" | grep -iE 'Error|Traceback' | head -1 | cut -c1-120)"
    else
        last_epoch=$(date -d "$last_ts" +%s 2>/dev/null || echo "$t1")
        quiet=$(( t1 - last_epoch ))
        if [ "$iters" -eq 0 ]; then
            echo "RESULT ${label} = NO-PROGRESS (0 iters, quiet ${quiet}s) :: $(printf '%s' "$S" | grep -iE 'Error' | head -1 | cut -c1-110)"
        elif [ "$quiet" -gt 60 ]; then
            echo "RESULT ${label} = STALLED (quiet ${quiet}s, reached ${n})"
        else
            echo "RESULT ${label} = HEALTHY (active to kill, reached ${n})"
        fi
    fi
    echo "===== END ${label} ====="
}

# V1 is decisive: torch 2.13 + old stack, the config that stalls on 2026.1.0.
arm V1-random-tp2 --model large --dataset random --tp 2
arm V2-imdb-tp2   --model large --dataset stanfordnlp/imdb --tp 2
arm V3-imdb-tp1   --model large --dataset stanfordnlp/imdb --tp 1
arm V4-random-tp4 --model large --dataset random --tp 4

echo "PBS_DONE"
