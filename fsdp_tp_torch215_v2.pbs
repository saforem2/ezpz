#!/bin/bash -l
#PBS -N fsdptp-t215b
#PBS -l select=2
#PBS -l walltime=00:40:00
#PBS -q next-eval
#PBS -A datascience
#PBS -l filesystems=home:flare
#PBS -o /home/foremans/fsdptp-t215b.log
#PBS -j oe
#
# Round 2 of the torch 2.15 test. Round 1 (job 8868889) was VOID: every
# arm died in ~1 s with
#
#   RuntimeError: The device index is out of range. It must be in [0, 6), but got 7
#
# Aurora has 6 PVCs x 2 tiles; ZE_FLAT_DEVICE_HIERARCHY=FLAT is what
# exposes the 12 tiles as separate devices. I skipped `module load
# frameworks` (correct for next-eval -- it would drag back the 2.13 conda
# stack) but that also skipped ezpz_setup_xpu, which is where
# utils.sh:1127 exports that variable. Removed the module load without
# replacing what it provided.
#
# So: set the XPU environment explicitly, and ASSERT the device count on
# the compute node before spending the allocation. A login-node probe
# reports 0 devices and proves nothing either way.
V=/lus/flare/projects/AuroraGPT/foremans/venvs/xpu-torch215
PY="$V/bin/python"
[[ -x "$PY" ]] || { echo "FATAL: no interpreter at $PY"; exit 1; }

# What ezpz_setup_xpu would have exported (utils.sh:1125-1130), minus the
# frameworks module itself. CCL_OP_SYNC deliberately left UNSET: #247
# established that collective semantics are the application's choice, and
# the earlier sweep showed forcing it changes nothing here.
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export CCL_PROCESS_LAUNCHER=pmix
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export TORCH_CPP_LOG_LEVEL=ERROR
# next-eval requires this for oneCCL KVS init (ALCF guidance); debug does not.
unset CCL_KVS_MODE
export CCL_KVS_MODE=pmi
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export WANDB_MODE=disabled PYTHONUNBUFFERED=1

SRC="${HOME}/ezpz-src"
export PYTHONPATH="${SRC}/src:${PYTHONPATH:-}"
echo "host=$(hostname)  ezpz=$(cd "$SRC" && git rev-parse --short HEAD)"
echo "torch=$("$PY" -c 'import torch;print(torch.__version__)' 2>&1 | tail -1)"
echo "CCL_KVS_MODE=${CCL_KVS_MODE}  ZE_FLAT=${ZE_FLAT_DEVICE_HIERARCHY}"

# Gate: 12 tiles must be visible ON THIS COMPUTE NODE, or -ppn 12
# over-subscribes and every rank >= 6 dies instantly (round 1's failure).
NDEV=$("$PY" -c 'import torch;print(torch.xpu.device_count())' 2>&1 | tail -1)
echo "xpu device_count=${NDEV}"
if [ "${NDEV}" != "12" ]; then
    echo "FATAL: expected 12 visible tiles, got '${NDEV}' -- aborting rather"
    echo "       than reporting rank-mapping failures as fsdp_tp stalls."
    exit 1
fi

W="${HOME}/fsdptp-t215b-${PBS_JOBID%%.*}"
mkdir -p "$W"
cd "$W" || exit 1

BUDGET=300
arm() {
    local label="$1"; shift
    echo "===== BEGIN ${label} ====="
    local t1
    timeout "${BUDGET}" mpiexec -n 24 -ppn 12 "$PY" -m ezpz.examples.fsdp_tp \
        "$@" >"${W}/${label}.log" 2>&1
    t1=$(date +%s)
    # Classify on the last TIMESTAMPED line vs kill time. Exit code,
    # iteration count and file mtime have each given a wrong verdict in
    # this investigation; mtime keeps advancing from untimestamped CCL
    # warnings for hours after progress stops.
    local S last_ts last_epoch quiet iters n
    S=$(sed 's/\x1b\[[0-9;]*m//g' "${W}/${label}.log")
    iters=$(printf '%s' "$S" | grep -coE 'iter=[0-9]+')
    n=$(printf '%s' "$S" | grep -oE 'iter=[0-9]+' | tail -1)
    last_ts=$(printf '%s' "$S" | grep -oE '^\[20[0-9]{2}-[0-9]{2}-[0-9]{2} [0-9:]{8}\]' | tail -1 | tr -d '[]')
    if [ -z "$last_ts" ]; then
        echo "RESULT ${label} = NO-OUTPUT :: $(printf '%s' "$S" | grep -iE 'Error|Traceback' | head -1 | cut -c1-120)"
    else
        last_epoch=$(date -d "$last_ts" +%s 2>/dev/null || echo "$t1")
        quiet=$(( t1 - last_epoch ))
        if [ "$iters" -eq 0 ]; then
            echo "RESULT ${label} = NO-PROGRESS (0 iters, quiet ${quiet}s) :: $(printf '%s' "$S" | grep -iE 'Error|RuntimeError' | head -1 | cut -c1-110)"
        elif [ "$quiet" -gt 60 ]; then
            echo "RESULT ${label} = STALLED (quiet ${quiet}s, reached ${n})"
        else
            echo "RESULT ${label} = HEALTHY (active to kill, reached ${n})"
        fi
    fi
    echo "===== END ${label} ====="
}

# T1 is decisive: this config stalls within ~1 s of real work on 2.13.
arm T1-random-tp2 --model large --dataset random --tp 2
arm T2-imdb-tp2   --model large --dataset stanfordnlp/imdb --tp 2
arm T3-imdb-tp1   --model large --dataset stanfordnlp/imdb --tp 1
arm T4-random-tp4 --model large --dataset random --tp 4

echo "PBS_DONE"
